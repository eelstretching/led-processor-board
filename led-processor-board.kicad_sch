	)
	(text "RM2 gSPI: GPIO43 = WL_ON + BT_ON, GPIO44 = CS, GPIO45 = DATA (DI direct,\nDO through R14, IRQ through R15), GPIO46 = CLK. Same circuit as the Pico 2 W,\nmoved off GPIO23/24/25/29; set CYW43_DEFAULT_PIN_* in the board header.\nHand-solder U5 (not stocked at LCSC). Keep copper out from under the antenna end."
		(exclude_from_sim no)
		(at 26.67 119.38 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
