			)
			(justify left bottom)
		)
		(uuid "21824f18-1161-460e-a1b1-fc5cd04b758c")
	)
	(text "If using RP2354 (internal flash), remove R10.\nR9 can be fit to use U3 as secondary memory."
		(exclude_from_sim no)
		(at 40.64 182.372 0)
		(effects
