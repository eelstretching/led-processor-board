	(text "8 MB PSRAM (U4) on the second QSPI chip select (XIP_SS_N[1]), moved from GPIO0 to GPIO47.\nR13 pull-up keeps it deselected at power-up (GPIOs default to pull-downs). Fit R11 = 0R."
		(exclude_from_sim no)
		(at 28.956 259.842 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "0854b8e8-311c-423a-bb3d-a78530493b26")
	)
	(text "RTC and headers"
