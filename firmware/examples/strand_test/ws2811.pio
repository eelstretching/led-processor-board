;
; WS2811/WS2812 serial output at 800 kHz, one bit per 10 PIO cycles: high for 3, then high or low
; for 4 depending on the bit, then low for 3. The same timing as the SDK's ws2812 example.
;
.program ws2811
.side_set 1

.define public T1 3
.define public T2 4
.define public T3 3

.wrap_target
bitloop:
    out x, 1       side 0 [T3 - 1]
    jmp !x do_zero side 1 [T1 - 1]
do_one:
    jmp bitloop    side 1 [T2 - 1]
do_zero:
    nop            side 0 [T2 - 1]
.wrap

% c-sdk {
#include "hardware/clocks.h"

static inline void ws2811_program_init(PIO pio, uint sm, uint offset, uint pin, float freq) {
    pio_gpio_init(pio, pin);
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 1, true);

    pio_sm_config c = ws2811_program_get_default_config(offset);
    sm_config_set_sideset_pins(&c, pin);
    // 24 bits per pixel, MSB first, pulled automatically.
    sm_config_set_out_shift(&c, false, true, 24);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);

    int cycles_per_bit = ws2811_T1 + ws2811_T2 + ws2811_T3;
    sm_config_set_clkdiv(&c, clock_get_hz(clk_sys) / (freq * cycles_per_bit));

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}
